# Copy to .env and fill in. Never commit .env.

# live: real machines and the Meta Model API. mock: simulated workers, no GPUs, network or spend.
CF_MODE=live

# Optional profile with your machines, limits and policies (merged over cinemafabric/profiles/default.toml).
CF_PROFILE=

# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
CF_META_API_BASE=https://api.meta.ai/v1

# Lets a node register its machines (and nothing else). Empty: generated once into data/join_token.
CF_JOIN_TOKEN=

# Full access to the fabric API; the studio and tools send it. Empty: generated once into data/fabric_token.
CF_FABRIC_TOKEN=

# Needed to change machines, the API key or the spending limit from anywhere but this computer
# (including through Docker port mappings). Empty: those settings only work from localhost.
CF_ADMIN_PASSWORD=

CF_FABRIC_URL=http://127.0.0.1:8100
CF_DATA_DIR=data

# --- Optional: running it for more than one person ---
# Sign-in, per-person films, and daily allowances. The first account becomes the admin.
CF_ACCOUNTS=false
CF_SIGNUP=invite
CF_USER_DAILY_USD=2
CF_USER_MAX_ACTIVE=2
# Postgres instead of SQLite files (pip install ".[postgres]"), e.g. postgresql://user:pass@host:5432/cinemafabric
CF_DATABASE_URL=
# Copy finished films to an S3-compatible bucket (pip install ".[s3]"); AWS_* variables hold the credentials.
CF_MEDIA_BUCKET=
CF_S3_ENDPOINT=
# How many films one studio makes at once.
CF_PARALLEL_PRODUCTIONS=1

# --- Optional: Content Credentials (C2PA), needs the [c2pa] extra ---
# Your signing certificate chain and private key (PEM). Empty: a local certificate is made in the data directory;
# files still verify as intact, but viewers will say the signer isn't publicly trusted.
CF_C2PA_CERT=
CF_C2PA_KEY=

# --- Optional: monitoring (docker compose --profile monitoring) ---
# Grafana's admin password (empty: Grafana's default, which it asks you to change at first sign-in).
# Prometheus and Grafana listen on this computer only.
GRAFANA_ADMIN_PASSWORD=
